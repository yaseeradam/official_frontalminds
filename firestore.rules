
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to create a document in the 'contacts' collection.
    // This is for the public contact form.
    // Nobody can read, update, or delete contact documents.
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
