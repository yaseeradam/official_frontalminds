rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to most collections, but restrict writes.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Allow anyone to create a document in the 'contacts' collection.
    // This is for the public contact form.
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Allow anyone to create a document in the 'newsletter_subscriptions' collection.
    match /newsletter_subscriptions/{subscriptionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
